# Copy to .env.local for local development. Never commit real credentials.

# The single persistence switch (PRD section 1b). Plain server-side variable,
# deliberately NOT prefixed NEXT_PUBLIC_ so it is never bundled into client JS.
# Default false: the public demo runs in not-stored mode. Flipping this to
# "true" (with real Supabase credentials below) is the only change required to
# turn on real data collection - see lib/supabase/client.ts.
PERSIST_DATA=false

# Server-only. Only read when PERSIST_DATA=true (lib/supabase/client.ts never
# even looks at these when the flag is off). Use a Supabase project hosted in
# AWS eu-west-2 (London) for UK GDPR compliance, per decisions.md Decision 5.
# SUPABASE_SERVICE_KEY is the service-role key: it must never be prefixed
# NEXT_PUBLIC_ and must never be used in any client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
